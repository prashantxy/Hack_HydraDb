# ChainTrace CLI — Environment Variables
# Copy to .env and fill in values.

# Backend API URL (default: http://localhost:3000)
CHAINTRACE_API_URL=https://api.chaintrace.dev

# Frontend dashboard URL for terminal links (default: http://localhost:3001)
CHAINTRACE_DASHBOARD_URL=https://chaintrace.dev

# GitHub OAuth Client ID (for device flow login)
GITHUB_CLIENT_ID=

# Debug mode (optional)
# CHAINTRACE_DEBUG=1
